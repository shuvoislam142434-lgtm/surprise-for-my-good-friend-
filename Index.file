<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday Fariha! ✨🌙</title>
    <link rel="stylesheet" href="style.css">
    <!-- Three.js Library Import -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>

    <!-- Start Overlay Screen -->
    <div id="start-overlay">
        <div class="card">
            <h1>A Special Journey Awaits ✨</h1>
            <p>একটি সুন্দর অভিজ্ঞতার জন্য সাউন্ড অন রাখুন ও হেডফোন ব্যবহার করুন</p>
            <button id="start-btn">অভিজ্ঞতা শুরু করুন 🚀</button>
        </div>
    </div>

    <!-- Dialogue Box -->
    <div id="dialogue-box" class="hidden">
        <p id="dialogue-text"></p>
    </div>

    <!-- Interactive Candle Blow Button -->
    <div id="interaction-prompt" class="hidden">
        <button id="blow-candle-btn">🎂 মোমবাতি ফুঁ দিয়ে নেভাও (Tap to Blow)</button>
    </div>

    <!-- 3D Canvas Container -->
    <div id="webgl-container"></div>

    <script src="script.js"></script>
</body>
</html>
